# Database (Supabase PostgreSQL pooler or direct)
DATABASE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=your-database-password

# Database aliases (if using DB_URL in Render)
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-database-password

# Security / JWT
JWT_SECRET=your-256-bit-secret-must-be-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile

# CORS & Server
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.netlify.app
PORT=8080

# Frontend (set in Netlify Environment Variables or frontend/.env)
VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1
